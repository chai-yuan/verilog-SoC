{
  "schema_version": "1.0",
  "metadata": {
    "name": "uart_axil_top",
    "version": "1.0.0",
    "author": "verilog-SoC",
    "description": "Memory-mapped UART controller with AXI4-Lite slave interface."
  },
  "parameters": {
    "ADDR_WIDTH": {
      "default": "32",
      "description": "AXI address bus width."
    },
    "DATA_WIDTH": {
      "default": "32",
      "description": "AXI data bus width."
    },
    "TX_FIFO_DEPTH": {
      "default": "16",
      "description": "Transmit FIFO depth."
    },
    "RX_FIFO_DEPTH": {
      "default": "16",
      "description": "Receive FIFO depth."
    },
    "DEFAULT_PRESCALE": {
      "default": "16'd50",
      "description": "Default UART baud prescale value."
    }
  },
  "interfaces": {
    "CLOCK_RESET": {
      "type": "clock_reset",
      "mode": "slave",
      "description": "System clock and active-high reset."
    },
    "S_AXIL": {
      "type": "axil",
      "mode": "slave",
      "description": "Upstream AXI4-Lite connection."
    }
  },
  "ports": {
    "clock": { "direction": "input", "width": "1", "interface": "CLOCK_RESET", "role": "clock" },
    "reset": { "direction": "input", "width": "1", "interface": "CLOCK_RESET", "role": "reset" },

    "s_axi_awvalid": { "direction": "input", "width": "1", "interface": "S_AXIL", "role": "AWVALID" },
    "s_axi_awready": { "direction": "output", "width": "1", "interface": "S_AXIL", "role": "AWREADY" },
    "s_axi_awaddr": { "direction": "input", "width": "ADDR_WIDTH", "interface": "S_AXIL", "role": "AWADDR" },
    "s_axi_awprot": { "direction": "input", "width": "3", "interface": "S_AXIL", "role": "AWPROT" },
    "s_axi_wvalid": { "direction": "input", "width": "1", "interface": "S_AXIL", "role": "WVALID" },
    "s_axi_wready": { "direction": "output", "width": "1", "interface": "S_AXIL", "role": "WREADY" },
    "s_axi_wdata": { "direction": "input", "width": "DATA_WIDTH", "interface": "S_AXIL", "role": "WDATA" },
    "s_axi_wstrb": { "direction": "input", "width": "DATA_WIDTH/8", "interface": "S_AXIL", "role": "WSTRB" },
    "s_axi_bvalid": { "direction": "output", "width": "1", "interface": "S_AXIL", "role": "BVALID" },
    "s_axi_bready": { "direction": "input", "width": "1", "interface": "S_AXIL", "role": "BREADY" },
    "s_axi_bresp": { "direction": "output", "width": "2", "interface": "S_AXIL", "role": "BRESP" },
    "s_axi_arvalid": { "direction": "input", "width": "1", "interface": "S_AXIL", "role": "ARVALID" },
    "s_axi_arready": { "direction": "output", "width": "1", "interface": "S_AXIL", "role": "ARREADY" },
    "s_axi_araddr": { "direction": "input", "width": "ADDR_WIDTH", "interface": "S_AXIL", "role": "ARADDR" },
    "s_axi_arprot": { "direction": "input", "width": "3", "interface": "S_AXIL", "role": "ARPROT" },
    "s_axi_rvalid": { "direction": "output", "width": "1", "interface": "S_AXIL", "role": "RVALID" },
    "s_axi_rready": { "direction": "input", "width": "1", "interface": "S_AXIL", "role": "RREADY" },
    "s_axi_rdata": { "direction": "output", "width": "DATA_WIDTH", "interface": "S_AXIL", "role": "RDATA" },
    "s_axi_rresp": { "direction": "output", "width": "2", "interface": "S_AXIL", "role": "RRESP" },

    "interrupt": {
      "direction": "output",
      "width": "1",
      "description": "UART interrupt output."
    },
    "rx": {
      "direction": "input",
      "width": "1",
      "description": "UART receive data."
    },
    "tx": {
      "direction": "output",
      "width": "1",
      "description": "UART transmit data."
    }
  },
  "files": {
    "hdl": [
      "hw/uart/rtl/uart_axil_top.v",
      "hw/uart/rtl/uart_reg_top.v",
      "hw/uart/rtl/uart_rx.v",
      "hw/uart/rtl/uart_tx.v"
    ]
  }
}
